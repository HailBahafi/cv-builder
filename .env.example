# AI provider selection — "openai" or "gemini". If unset, falls back to
# whichever of the two API keys below is present (OpenAI takes priority).
AI_PROVIDER=

# OpenAI API Key — paste your key locally in .env only (never commit real keys)
OPENAI_API_KEY=

# Gemini API Key (Google AI Studio) — free-tier alternative to OpenAI
AI_PROVIDER=gemini
GEMINI_API_KEY=

# App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000
